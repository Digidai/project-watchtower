[Unit]
Description=Encrypted Cloudflare Tunnel for Watchtower
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cloudflared
Group=cloudflared
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --protocol http2 --metrics 127.0.0.1:20241 run --token-file /etc/cloudflared-watchtower/token
Restart=always
RestartSec=5
MemoryMax=128M
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
