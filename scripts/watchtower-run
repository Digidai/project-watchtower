#!/usr/bin/env bash
set -Eeuo pipefail

MODE="${1:-core}"
case "$MODE" in
  core|self|github-lite|daily|weekly|venture-check|venture-discover) ;;
  *) echo "invalid mode: $MODE" >&2; exit 64 ;;
esac

APP_DIR="${WATCHTOWER_APP_DIR:-/opt/project-watchtower}"
STATE_DIR="${WATCHTOWER_STATE_DIR:-/var/lib/project-watchtower}"
LOCK_DIR="${WATCHTOWER_LOCK_DIR:-$STATE_DIR/project-watchtower.lock}"

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  if [ "${WATCHTOWER_BUSY_OK:-0}" = "1" ]; then
    printf '{"status":"busy","message":"watchtower already running"}\n'
    exit 0
  else
    echo "watchtower already running" >&2
    exit 75
  fi
fi
trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT

cd "$APP_DIR"
export PYTHONPATH="$APP_DIR"
args=(
  run
  --mode "$MODE"
  --config "$APP_DIR/config/targets.json"
  --output-dir "$STATE_DIR/reports"
  --no-fail
)
if [ -n "${WATCHTOWER_MAX_URLS:-}" ]; then
  args+=(--max-urls "$WATCHTOWER_MAX_URLS")
fi
if [ -n "${WATCHTOWER_MAX_BYTES:-}" ]; then
  args+=(--max-bytes "$WATCHTOWER_MAX_BYTES")
fi

nice -n 10 python3 -m watchtower.cli "${args[@]}"
