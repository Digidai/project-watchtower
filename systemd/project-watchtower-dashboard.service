[Unit]
Description=Project Watchtower status dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=watchtower
Group=watchtower
WorkingDirectory=/opt/project-watchtower
Environment=PYTHONPATH=/opt/project-watchtower
EnvironmentFile=/etc/project-watchtower/dashboard.env
ExecStart=/usr/bin/python3 -m watchtower.cli serve --output-dir /var/lib/project-watchtower/reports --host 127.0.0.1 --port 8765
Restart=always
RestartSec=5
MemoryMax=160M
CPUQuota=20%
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadOnlyPaths=/var/lib/project-watchtower/reports

[Install]
WantedBy=multi-user.target
