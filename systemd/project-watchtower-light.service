[Unit]
Description=Project Watchtower light health check
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=watchtower
Group=watchtower
WorkingDirectory=/opt/project-watchtower
ExecStart=/opt/project-watchtower/scripts/watchtower-run light
Nice=10
TimeoutStartSec=180
MemoryMax=350M
CPUQuota=30%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/project-watchtower /tmp
